{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview site",
      "type": "shell",
      "command": "npm install && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "preview",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": true,
          "beginsPattern": "Built",
          "endsPattern": "Preview running"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
